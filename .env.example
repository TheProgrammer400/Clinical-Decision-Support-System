# App Configuration
NODE_ENV=development
PORT=4000

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://cdss_user:cdss_password@localhost:5432/cdss_db?schema=public"

# Auth Secrets (Min 32 chars in production)
JWT_ACCESS_SECRET=dev_jwt_access_secret_key_change_in_production_12345
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_change_in_production_67890
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# Groq LLM Configuration (Backend Server-Side Only)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL_NAME=openai/gpt-oss-120b
GROQ_REQUEST_TIMEOUT_MS=60000

# Prompt Versioning
PROMPT_VERSION=v1.3.0

# Observability
SENTRY_DSN=
LOG_LEVEL=debug

# AWS Region (for secrets / deployment)
AWS_REGION=us-east-1

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
