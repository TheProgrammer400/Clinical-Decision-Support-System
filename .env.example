# Backend configuration. Copy to backend/.env for local development (never commit real values).
# Every variable is validated at startup; the server refuses to start on invalid configuration.

NODE_ENV=development
PORT=4000

# PostgreSQL connection
DATABASE_URL="postgresql://cdss_user:cdss_password@localhost:5432/cdss_db?schema=public"

# Required. At least 32 random characters, e.g. `openssl rand -hex 32`.
# Published example values are rejected outside NODE_ENV=development.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=900
# Lifetime of single-use refresh tokens (seconds)
REFRESH_TOKEN_TTL=1209600

# Browser origins allowed to call the API (comma-separated). Required for any deployment.
CORS_ORIGINS=http://localhost:3000
# Defaults to true when NODE_ENV=production; refresh cookies then require HTTPS.
COOKIE_SECURE=false
# Number of reverse-proxy hops to trust for client IPs (defaults to 1 in production).
# TRUST_PROXY=1

# LLM. Either a real Groq key, or LLM_MOCK=true (development/test only; output is labelled synthetic).
LLM_MOCK=true
GROQ_API_KEY=
GROQ_MODEL_NAME=openai/gpt-oss-120b
GROQ_REQUEST_TIMEOUT_MS=60000

# MRI inference service
MRI_INFERENCE_SERVICE_URL=http://localhost:8000
# Shared secret sent as X-Inference-Token; set the same value as INFERENCE_TOKEN on the service.
MRI_INFERENCE_TOKEN=
MRI_INFERENCE_TIMEOUT_MS=120000
MRI_MAX_UPLOAD_SIZE_MB=20
MRI_MAX_FILES=10
ARTIFACT_STORAGE_DIR=uploads/mri

# Enables TOTP two-step verification: 32 random bytes, base64 (`openssl rand -base64 32`).
MFA_ENCRYPTION_KEY=

# Development seed only (npm run prisma:seed). Random passwords are printed if unset.
SEED_ADMIN_PASSWORD=
SEED_DOCTOR_PASSWORD=

LOG_LEVEL=debug

# Frontend (build time)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
