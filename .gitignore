# Environment & Secrets (NEVER COMMIT ACTUAL SECRETS)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env.local
*.env
!*.env.example

# Dependency directories
node_modules/
backend/node_modules/
frontend/node_modules/

# Node.js logs & diagnostics
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Backend Build & Test Outputs
backend/dist/
backend/coverage/
backend/.nest/

# Next.js Frontend Build & Cache
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel

# Prisma Generated Clients & Databases
*.db
*.sqlite
*.sqlite3

# Terraform Infrastructure State & Variables
infrastructure/terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!example.tfvars
override.tf
override.tf.json
.terraform.lock.hcl

# Operating System & IDE Files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.user
*.userosql
*.sln.docstates

# Diagnostic & Scratch Files
tmp/
temp/
scratch/

# everything except READMD.md file
*.md
!README.md

# Ignore AWS Infrastructure & GitHub CI/CD workflows
.github/
infrastructure/
