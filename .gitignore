# Environment & Secrets (NEVER COMMIT ACTUAL SECRETS)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env.local
mri-inference-service/.env
*.env
!*.env.example

# Dependency directories & Virtual Environments
node_modules/
backend/node_modules/
frontend/node_modules/
venv/
.venv/
env/
mri-inference-service/venv/
mri-inference-service/.venv/

# Node.js logs & diagnostics
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Python Caches & Build Outputs
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/

# Large Model Checkpoints & Weights
*.pth
*.pt
*.bin
*.onnx
mri-inference-service/models/*.pth
!mri-inference-service/models/.gitkeep

# Local Uploads & Storage Artifacts
uploads/
backend/uploads/
*.png
*.jpg
*.jpeg
*.webp
!frontend/public/**/*

# Backend Build & Test Outputs
backend/dist/
backend/coverage/
backend/.nest/

# Next.js Frontend Build & Cache
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel

# Prisma Generated Clients & Databases
*.db
*.sqlite
*.sqlite3

# Terraform Infrastructure State & Variables
infrastructure/terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!example.tfvars
override.tf
override.tf.json
.terraform.lock.hcl

# Operating System & IDE Files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.user
*.userosql
*.sln.docstates

# Diagnostic & Scratch Files
tmp/
temp/
scratch/

*.md
!README.md

# Ignore AWS Infrastructure & GitHub CI/CD workflows
.github/
infrastructure/

# unneccessary files
additional/